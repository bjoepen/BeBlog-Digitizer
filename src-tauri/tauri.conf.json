{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeBlog Digitizer",
  "version": "0.1.0",
  "identifier": "de.beblog.digitizer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "BeBlog Digitizer",
      "width": 1120,
      "height": 820,
      "minWidth": 760,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "sidecars/macos-aarch64/beblog-test-sidecar": "sidecars/macos-aarch64/beblog-test-sidecar"
    }
  }
}
